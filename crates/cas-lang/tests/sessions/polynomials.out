> expand((x+1)^2*(y-1))
= -1 - 2*x - x^2 + y + 2*x*y + x^2*y
> expand(sin((x+1)^2))
= sin(1 + 2*x + x^2)
> expand((x+1)^2/(x-1)^2)
= 1/(1 - 2*x + x^2) + 2*x/(1 - 2*x + x^2) + x^2/(1 - 2*x + x^2)
> expand(1/x+1/(x+1))
= 1/x + 1/(1 + x)
> expand((1+1/(x+1))*(x+2))
= 2 + x + 2/(1 + x) + x/(1 + x)
> expand(exp(a+b))
= exp(a + b)
> 2*(x+1)
= 2*(1 + x)
> expand((x+1.5)^2)
= 2.25 + 3.0*x + x^2
> normal(1/x+1/(x+1))
= (1 + 2*x)/(x + x^2)
> normal((x^2-1)/(x^2+2*x+1))
= (-1 + x)/(1 + x)
> normal(1/(1-x))
= -1/(-1 + x)
> normal(x/2+y/3)
= x/2 + y/3
> gcd(6*x^2-6, 4*x-4)
= -2 + 2*x
> gcd(x^2-1/100, x-1/10)
= -1 + 10*x
> gcd(1/2, 1/3)
= 1/6
> gcd(12, 18)
= 6
> lcm(6*x^2-6, 4*x-4)
= -12 + 12*x^2
> lcm(4, 6)
= 12
> quo(x^3+1, x+1)
= 1 - x + x^2
> rem(x^3+2, x+1)
= 1
> quorem(x^3+2, x+1)
= [1 - x + x^2, 1]
> quo(x^2, y*x+1, x)
= -1/y^2 + x/y
> degree(x^3+x*y^5, y)
= 5
> degree(pi*x^2)
= 2
> degree(0, x)
= -infinity
> coeff(x^3+2*x+5, x, 1)
= 2
> coeff(x^2+3*x, x)
= [1, 3, 0]
> lcoeff(y*x^2+x, x)
= y
> numer(1/2+x)
= 1 + 2*x
> denom(1/2+x)
= 2
> content(-6*x^2-4*x)
= 2
> primpart(-6*x^2-4*x)
= -2*x - 3*x^2
> resultant(x*y-1, x^2+y^2-4, x)
= 1 - 4*y^2 + y^4
> discriminant(a*x^2+b*x+c, x)
= b^2 - 4*a*c
> degree(y^3+y)
= 3
