// Decimal literals are balls (CAS-148, CAS-DOC-5 §6.4, D1–D4).
0.1 + 0.2
0.1 + 0.2 == 0.3
1/3.0
sqrt(2.0)
2.0*3
// Exact when binary holds them: 0.5, 2.0, 1e10.
0.5 + 0.25 == 3/4
1e10
// Long literals keep their digits.
0.1000000000000000000000000001
0.1000000000000000000000000001*3
// Tiny and huge.
1e-400
6.02e23
// In expressions: a coefficient stays, its sign in front.
x + 0.5
x - 0.5*y
-0.5*x
1.5 + 2.5*i
// Back to fractions (D4).
exact(0.1)
exact(0.333333333333)
exact(0.3333)
exact(0.7)
exact(1/3.0)
exact(0.1 + 0.2)
exact(0.5*x + 1.5)
exact(3.14159)
exact(1.5e-5)
// A definition takes its literals when it is made.
f(t) := t + 0.1
f(1)
