// Polynomial builtins, phase 1, with Xcas's names (CAS-DOC-8 §7–§10, §15;
// CAS-140).
expand((x+1)^2*(y-1))
expand(sin((x+1)^2))
expand((x+1)^2/(x-1)^2)
// Term by term: each term keeps its denominator.
expand(1/x+1/(x+1))
expand((1+1/(x+1))*(x+2))
// Algebra only: exp(a+b) stays, and evaluation never expands.
expand(exp(a+b))
2*(x+1)
// Decimals are balls, coefficients of arithmetic.
expand((x+1.5)^2)
normal(1/x+1/(x+1))
normal((x^2-1)/(x^2+2*x+1))
normal(1/(1-x))
normal(x/2+y/3)
gcd(6*x^2-6, 4*x-4)
gcd(x^2-1/100, x-1/10)
gcd(1/2, 1/3)
gcd(12, 18)
lcm(6*x^2-6, 4*x-4)
lcm(4, 6)
quo(x^3+1, x+1)
rem(x^3+2, x+1)
quorem(x^3+2, x+1)
quo(x^2, y*x+1, x)
degree(x^3+x*y^5, y)
degree(pi*x^2)
degree(0, x)
coeff(x^3+2*x+5, x, 1)
coeff(x^2+3*x, x)
lcoeff(y*x^2+x, x)
numer(1/2+x)
denom(1/2+x)
content(-6*x^2-4*x)
primpart(-6*x^2-4*x)
resultant(x*y-1, x^2+y^2-4, x)
discriminant(a*x^2+b*x+c, x)
// The variable is inferred when there is one (P5); otherwise the call
// stays, with a warning.
degree(y^3+y)
quo(x^2*y+1, x+y)
degree(sin(x), x)
// The exact algorithms refuse decimals (P8).
gcd(x^2-0.25, x-0.5)
normal(1/(x+0.5))
quo(x^2+1, 0)
discriminant(5, x)
